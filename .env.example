# Copy to .env and fill in your values
# cp .env.example .env

# Azure Data Lake Storage Gen2
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_KEY=your_storage_key
AZURE_CONTAINER_NAME=transactions
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret

# Azure SQL / Synapse Analytics
DATABASE_URL=mssql+pyodbc://user:password@server.database.windows.net/BankingDW?driver=ODBC+Driver+18+for+SQL+Server

# Core Banking API
CORE_BANKING_API_URL=https://api.corebanking.internal
CORE_BANKING_API_KEY=your_api_key

# Fraud Alert API
FRAUD_API_URL=https://api.fraud-alerts.internal
FRAUD_API_KEY=your_fraud_api_key

# FX Rates API
FX_RATE_API_URL=https://api.exchangeratesapi.io/v1
FX_RATE_API_KEY=your_fx_api_key

# Prefect
PREFECT_API_URL=http://127.0.0.1:4200/api

# Slack Alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
